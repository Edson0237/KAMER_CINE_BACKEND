# ============================================================
# .env.example — Variables d'environnement déploiement pilote
# KAMER CINÉ TALENTS MANAGER
# ============================================================
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer le fichier .env avec des secrets réels.

# --- Base de données PostgreSQL ---
POSTGRES_DB=kctm_db
POSTGRES_USER=kctm_pilote
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE_FORT_ICI
DB_HOST=kctm-postgres
DB_PORT=5432
DB_USER=kctm_pilote
DB_PASSWORD=CHANGER_MOT_DE_PASSE_FORT_ICI

# --- JWT ---
# Minimum 256 bits (32 caractères) pour HS256
JWT_SECRET=CHANGER_PAR_UNE_CLE_SECRETE_DE_64_CARACTERES_MINIMUM
JWT_EXPIRATION_MS=86400000

# --- Stockage S3-compatible (MinIO / AWS S3 / Backblaze B2) ---
S3_ENDPOINT=http://kctm-minio:9000
S3_REGION=us-east-1
S3_BUCKET=kctm-uploads
S3_ACCESS_KEY=CHANGER_ACCESS_KEY
S3_SECRET_KEY=CHANGER_SECRET_KEY
S3_PATH_STYLE_ACCESS=true

# --- Application ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Backup PostgreSQL ---
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=kctm-backups
